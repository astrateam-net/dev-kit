# test-authority — DEV ONLY. Copy to `.env`, fill in, never commit the real one.
#   set -a; . ./cmd/test-authority/.env; set +a
#   go run ./cmd/test-authority

# --- The gateway under test ---
DGW_GATEWAY_URL=https://localhost:7171      # gateway HTTPS API listener
DGW_PROVISIONER_KEY=./test-provisioner.pem  # PRIVATE half; public half goes on the gateway
DGW_TLS_INSECURE=true                        # set if the test gateway has a self-signed cert

# The gateway's player page. Enables redirect mode.
PLAYER_LAUNCH_URL=https://localhost:7171/jet/webapp/client/launch

# --- The real target + credential (server-side only; never reaches the browser) ---
TARGET_HOST=win-host.example.com:3389
TARGET_USER=alice
TARGET_PASS=                                 # the real password — keep it here, gitignored
# REALM: set for a DOMAIN target (forces the Kerberos client-acceptor → gateway needs its
# debug.kerberos block). LEAVE EMPTY for a first smoke test against a LOCAL account on the
# target (NTLM acceptor → no fake-KDC config needed).
REALM=

# --- This harness ---
LISTEN_ADDR=127.0.0.1:8722
DGW_SECRET_NAME=rdp-password
